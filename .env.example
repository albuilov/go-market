# HTTP-порты сервисов
FRONTEND_HTTP_PORT=8080
GATEWAY_HTTP_PORT=3000
SWAGGER_HTTP_PORT=3001

# gRPC-порты сервисов
CATALOG_GRPC_PORT=50051

# JWT-конфигурация только для локальной разработки
JWT_SECRET=local-development-secret-must-be-at-least-32-bytes
JWT_ISSUER=go-market-auth
JWT_AUDIENCE=go-market-api
